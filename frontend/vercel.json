{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dudhrej-backend.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://dudhrej-backend.vercel.app/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).*[^/])",
      "destination": "/index.html"
    }
  ]
}
