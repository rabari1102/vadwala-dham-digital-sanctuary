{
  "version": 2,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vadwala-dham-digital-sanctuary-9vk1.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://vadwala-dham-digital-sanctuary-9vk1.vercel.app/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).*[^/])",
      "destination": "/index.html"
    }
  ]
}
